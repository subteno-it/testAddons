<templates id="template" xml:space="preserve">
    <t t-name="pos_receipt_wo_price.ReceiptScreenWithNoPriceTicket"
       t-inherit="point_of_sale.ReceiptScreen"
       t-inherit-mode="extension"
       t-owl="1">
        <xpath expr="//div[hasclass('buttons')]" position="after">
            <t t-if="env.pos.config.allow_receipts_without_price">
                <div class="buttons">
                    <div class="button print" t-on-click="printReceiptWithoutPrice">
                        <i class="fa fa-print"></i> Print Receipt Without Price
                    </div>
                </div>
            </t>
        </xpath>

        <xpath expr="//div[hasclass('pos-receipt-container')]" position="after">
            <t t-if="env.pos.config.allow_receipts_without_price">
                <div id="receipt-without-price" style="display: none;">
                    <OrderReceiptWithoutPrice order="currentOrder" t-ref="order-receipt-without-price"/>
                </div>
            </t>
        </xpath>

        <xpath expr="//div[hasclass('pos-receipt-container')]" position="attributes">
            <attribute name="id">receipt-with-price</attribute>
        </xpath>
    </t>
</templates>
