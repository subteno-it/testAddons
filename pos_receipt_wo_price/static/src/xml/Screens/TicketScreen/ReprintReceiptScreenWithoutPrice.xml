<templates id="template" xml:space="preserve">
    <t t-name="ReprintReceiptScreenWithoutPrice" owl="1">
        <div class="receipt-screen screen">
            <div class="screen-content">
                <div class="top-content">
                    <span class="button back" t-on-click="confirm">
                        <i class="fa fa-angle-double-left"></i>
                        <span> </span>
                        <span>Back</span>
                    </span>
                </div>

                <div class="centered-content">
                    <div class="button print" t-on-click="tryReprint">
                        <i class="fa fa-print"></i> Print Receipt Without Price
                    </div>
                    <div class="pos-receipt-container">
                        <OrderReceiptWithoutPrice order="props.order" t-ref="order-receipt"/>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
