<odoo>
    <record id="view_users_form_simple_modif_mail_custom" model="ir.ui.view">
        <field name="name">res.users.preferences.form.mail.custom</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="mail.view_users_form_simple_modif_mail"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='notification_type']" position="after">
                <field name="has_automatic_clear_on_click" invisible="notification_type != 'inbox'"/>
            </xpath>
        </field>
    </record>
</odoo>
